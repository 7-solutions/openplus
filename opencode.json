{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "provider": {
    "anthropic": {
      "options": { "apiKey": "{env:ANTHROPIC_API_KEY}" }
    },
    "openai": {
      "options": { "apiKey": "{env:OPENAI_API_KEY}" }
    },
    "local": {
      "name": "Local (OpenAI-compatible)",
      "options": { "baseURL": "http://localhost:11434/v1", "apiKey": "ollama" },
      "models": {
        "qwen2.5-coder": { "name": "Qwen2.5 Coder (local)" },
        "nomic-embed-text": { "name": "nomic-embed-text (embeddings)" }
      }
    }
  },
  "agent": {
    "build": { "description": "Full-tool build agent (default)" },
    "plan":  { "description": "Read-only analysis / spec design" }
  },
  "permission": {
    "bash": "ask",
    "write": "ask",
    "external_directory": { "/tmp/**": "ask" }
  }
}
